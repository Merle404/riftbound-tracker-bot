# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# How often to poll each watched event, in seconds (default 45)
POLL_INTERVAL_SECONDS=45

# Where the bot stores its roster + watch state (default ./data/state.json)
DATA_FILE=./data/state.json

# In groups, only admins may use /watch, /unwatch and /team add|remove|import (default true)
ADMIN_ONLY=true

# Betting: starting coins per user and chat, coins credited per calendar day, coins per button tap,
# and the round size above which only matches with roster players go on the betting board
BET_START_COINS=100
BET_DAILY_COINS=10
BET_STAKE=10
BET_MAX_MATCHES=40
# Minutes after the pairings during which match bets are taken (0 = until the result comes in)
BET_WINDOW_MINUTES=10
