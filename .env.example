# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# How often to poll each watched event, in seconds (default 45)
POLL_INTERVAL_SECONDS=45

# Where the bot stores its roster + watch state (default ./data/state.json)
DATA_FILE=./data/state.json

# In groups, only admins may use /watch, /unwatch and /team add|remove|import (default true)
ADMIN_ONLY=true
